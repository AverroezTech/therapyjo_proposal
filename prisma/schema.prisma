// TherapyJo — Prisma Schema
// Database: Supabase PostgreSQL

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────

enum Role {
  ADMIN
  DOCTOR
  SECRETARY
}

enum EmploymentStatus {
  ACTIVE
  RESIGNED
}

enum SessionStatus {
  SCHEDULED
  WAITING
  CHECKED_IN
  WITH_DOCTOR
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentType {
  CASH
  INSURANCE
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum PostLang {
  EN
  AR
}

enum ChangeField {
  NAME
  TITLE
  SPECIALTY
  BIO
  CONTACT
  PHOTO
}

enum ChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── User (Doctors, Secretaries, Admin) ───────────────

model User {
  id             String           @id @default(cuid())
  username       String           @unique
  passwordHash   String
  role           Role
  name           String
  email          String?
  phone          String?
  workingHours   String?
  pictureUrl     String?
  status         EmploymentStatus @default(ACTIVE)
  color          String?          // hex color for calendar (doctors only)
  canManageContent Boolean        @default(false) // may manage Blog, public Doctor profiles, Approvals
  failedLoginAttempts Int         @default(0)     // consecutive bad passwords; resets on success (TJ-024)
  lockedUntil    DateTime?                        // set once failedLoginAttempts crosses the threshold
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  reservations   Reservation[]    // doctor's reservations
  notes          Note[]           // notes linked to doctor
  doctorProfile  DoctorProfile?   // public-site profile, if this user has one
  files          EmployeeFile[]   // identification documents

  // Accountability — who touched what, and when (TJ-024)
  patientUpdates      Patient[]         @relation("PatientUpdatedBy")
  intakeUpdates       ClinicalIntake[]  @relation("IntakeUpdatedBy")
  patientFileUploads  PatientFile[]     @relation("FileUploadedBy")
  patientAuditEntries PatientAuditLog[]
}

// ─── Employee Files (identification documents) ────────
// Mirrors PatientFile, which is the established shape for an uploaded file in
// this schema. Cascades with the employee: the rows go, but note that nothing
// in this application ever removes the underlying object from Supabase Storage.

model EmployeeFile {
  id             Int              @id @default(autoincrement())
  userId         String
  fileName       String
  filePath       String           // Supabase Storage path
  fileType       String           // mime type
  fileSize       Int              // bytes
  uploadedAt     DateTime         @default(now())

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Patient ──────────────────────────────────────────

model Patient {
  id             Int              @id @default(autoincrement())
  name           String
  phone1         String
  phone2         String?
  pictureUrl     String?
  archived       Boolean          @default(false)
  lastVisitDate  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  updatedById    String?          // last staff member to touch this record (TJ-024)

  // Relations
  files          PatientFile[]
  intake         ClinicalIntake?
  reservations   Reservation[]
  auditLog       PatientAuditLog[]
  updatedBy      User?            @relation("PatientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

// ─── Patient Files (images, PDFs, X-rays) ─────────────

model PatientFile {
  id             Int              @id @default(autoincrement())
  patientId      Int
  fileName       String
  filePath       String           // Supabase Storage path
  fileType       String           // mime type
  fileSize       Int              // bytes
  uploadedAt     DateTime         @default(now())
  uploadedById   String?

  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy     User?            @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([uploadedById])
}

// ─── Clinical Intake / Assessment ─────────────────────

model ClinicalIntake {
  id                    Int       @id @default(autoincrement())
  patientId             Int       @unique
  injuryPlace           String?
  enrollDate            DateTime?
  medicalHistory        String?
  assessment            String?
  aggravators           String?   // What movements trigger pain
  relievers             String?   // What relieves pain
  diagnosis             String?
  treatmentPlan         String?
  recommendedSessions   Int?
  clinicExercises       String?
  homeExercises         String?
  nextSessionTreatment  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  updatedById           String?

  patient               Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  updatedBy             User?     @relation("IntakeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

// ─── Patient Audit Log (who did what, and when) ───────
// One row per meaningful write against a patient's record. Exists so an
// admin can answer "who changed this" without trusting the anonymous
// createdAt/updatedAt timestamps already on the models above. (TJ-024)

model PatientAuditLog {
  id        Int      @id @default(autoincrement())
  patientId Int
  userId    String?
  action    String   // "DEMOGRAPHICS_UPDATED" | "CLINICAL_INTAKE_UPDATED" | "FILE_ADDED" | "FILE_REMOVED" | "ARCHIVED" | "RESTORED"
  summary   String?
  createdAt DateTime @default(now())

  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([userId])
}

// ─── Reservation (Session) ────────────────────────────

model Reservation {
  id                  Int            @id @default(autoincrement())
  patientId           Int
  doctorId            String
  sessionDate         DateTime       // date only
  sessionTime         DateTime       // time within the day
  status              SessionStatus  @default(SCHEDULED)
  paymentType         PaymentType?
  isTwoHours          Boolean        @default(false)
  isNote              Boolean        @default(false)
  note                String?
  showNoteOnCalendar  Boolean        @default(false)
  nextSessionNote     String?
  injuryPlace         String?
  checkedInAt         DateTime?
  withDoctorAt        DateTime?
  checkedOutAt        DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  patient             Patient        @relation(fields: [patientId], references: [id])
  doctor              User           @relation(fields: [doctorId], references: [id])
  soapNote            SOAPNote?

  @@index([patientId])
  @@index([doctorId])
}

// ─── SOAP Note (Physio documentation) ─────────────────

model SOAPNote {
  id              Int          @id @default(autoincrement())
  reservationId   Int          @unique
  subjective      String?
  objective       String?
  assessment      String?
  plan            String?
  injuryPlace     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  reservation     Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

// ─── General Notes ────────────────────────────────────

model Note {
  id              Int          @id @default(autoincrement())
  name            String
  noteDate        DateTime
  doctorId        String
  doctorCheckNote Boolean      @default(false)
  details         String?
  createdAt       DateTime     @default(now())

  doctor          User         @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
}

// ─── Blog (public content) ────────────────────────────

model BlogPost {
  id          String      @id @default(cuid())
  slug        String      @unique
  lang        PostLang
  linkedId    String?     @unique
  linked      BlogPost?   @relation("PostTranslation", fields: [linkedId], references: [id])
  linkedFrom  BlogPost?   @relation("PostTranslation")
  title       String
  category    String
  body        String
  coverImage  String?
  status      PostStatus  @default(DRAFT)
  publishAt   DateTime?
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ─── Doctor profile (public site, CMS-managed) ────────

model DoctorProfile {
  id        String   @id @default(cuid())
  userId    String?  @unique   // linked login account, if the doctor has one
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  title     String
  specialty String
  bio       String?
  contact   String?
  photo     String?
  order     Int      @default(0)
  hidden    Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pendingChanges PendingChange[]
}

// ─── Doctor profile edit approvals ────────────────────

model PendingChange {
  id          String        @id @default(cuid())
  doctorId    String
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  field       ChangeField
  oldValue    String
  newValue    String
  submittedAt DateTime      @default(now())
  submittedBy String
  status      ChangeStatus  @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?

  @@index([doctorId])
}
